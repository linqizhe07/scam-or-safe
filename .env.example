# Server port
PORT=4100

# Payment scheme: mock (default, no chain) or solana (devnet, untested, see README)
PAYMENT_SCHEME=mock
# Payee address (used by the solana scheme; the mock scheme only writes it into the 402 quote)
PAYEE_ADDRESS=ScamOrSafePayee11111111111111111111111111111
SOLANA_RPC=https://api.devnet.solana.com
# USD per SOL; the solana scheme uses it to convert USD prices into lamports
SOL_USD=150

# The agent's total budget and per-call cap (USD)
AGENT_BUDGET_USD=0.25
AGENT_PER_CALL_MAX_USD=0.05
# Devnet secret key the agent pays with (solana scheme only; JSON array or base58, test wallets only)
# AGENT_KEYPAIR=

# With LIVE=1, the check routes query devnet for addresses / programs / transactions missing from the knowledge base (untested)
LIVE=0
