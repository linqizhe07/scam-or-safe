# 服务端口
PORT=4100

# 付款方案：mock（默认，无链）或 solana（devnet，未验证，见 README）
PAYMENT_SCHEME=mock
# 收款地址（solana 方案用；mock 方案只是写进 402 报价里）
PAYEE_ADDRESS=ScamOrSafePayee11111111111111111111111111111
SOLANA_RPC=https://api.devnet.solana.com
# 1 SOL 折合多少美元，solana 方案把美元价折成 lamports 用
SOL_USD=150

# agent 的总预算和单笔上限（美元）
AGENT_BUDGET_USD=0.25
AGENT_PER_CALL_MAX_USD=0.05
# agent 付款用的 devnet 私钥（solana 方案才需要；JSON 数组或 base58，只放测试钱包）
# AGENT_KEYPAIR=

# LIVE=1 时，检查路由对知识库里没有的地址/程序/交易去 devnet 查（未验证）
LIVE=0
