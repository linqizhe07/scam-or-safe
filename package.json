    "agent": "node agent/cli.js",
    "coverage": "node scripts/coverage.js",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "optionalDependencies": {
    "@solana/web3.js": "^1.98.0"
  }
}
