{
  "name": "scam-or-safe",
  "version": "0.1.0",
  "private": true,
  "description": "Scam or Safe: a Solana transaction-spotting game. Human vs agent; the agent buys checks within a budget, and the detector explains every wrong answer.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node server/index.js",
